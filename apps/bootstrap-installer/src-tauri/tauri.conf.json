{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Damon Agent",
  "version": "1.0.0",
  "identifier": "dev.damon-agent.setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Damon Agent Setup",
        "width": 880,
        "height": 620,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Damon Agent Installer",
    "longDescription": "Installs Damon Agent on your machine. Drives scripts/install.ps1 (Windows) and scripts/install.sh (macOS/Linux).",
    "publisher": "Damon Agent Team",
    "copyright": "Copyright © 2026 Damon Agent Team",
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "certificateThumbprint": "",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.acs.microsoft.com",
      "tsp": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "allowToChangeInstallationDirectory": true,
        "oneClick": false,
        "perMachine": true,
        "createDesktopShortcut": "always",
        "createStartMenuShortcut": true,
        "shortcutName": "Damon Agent",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "includeLicense": "LICENSE.md",
        "artifactName": "Damon-Setup-${version}-${arch}.${ext}",
        "installerHeaderIcon": "icons/icon.ico",
        "installerSidebar": "icons/sidebar.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "gatekeeperAssessment": "skip",
      "entitlements": "entitlements.plist",
      "artifactName": "Damon-Setup-${version}-${arch}.${ext}",
      "dmg": {
        "window": {
          "width": 540,
          "height": 380
        },
        "contents": [
          {
            "x": 180,
            "y": 170,
            "type": "file"
          },
          {
            "x": 360,
            "y": 170,
            "type": "link",
            "path": "/Applications"
          }
        ]
      }
    },
    "linux": {
      "artifactName": "Damon-Setup-${version}-${arch}.${ext}",
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-2"],
        "section": "devel",
        "priority": "optional"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libayatana-appindicator-gtk3", "librsvg2"],
        "license": "MIT",
        "section": "Development/Tools"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "process": {
      "launch": true,
      "exit": true
    }
  }
}